{
  "name": "minimart-management",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --sort run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter \"./apps/*-service\" -r db:generate",
    "db:migrate": "pnpm --filter \"./apps/*-service\" -r db:migrate",
    "db:seed": "pnpm --filter \"./apps/*-service\" -r db:seed",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dev1": "node scripts/verify-dev1.mjs",
    "verify:dev6": "node --env-file-if-exists=.env scripts/verify-dev6.mjs",
    "verify:final": "node scripts/verify-final.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.3",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "jest": "29.7.0",
    "prettier": "3.7.4",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
