# Local demo only. Use URL-safe passwords or URL-encode DATABASE_URL credentials.
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
SERVICE_CREDENTIAL=local-demo-service-credential-change-me-32chars
POSTGRES_USER=minimart_bootstrap
POSTGRES_PASSWORD=local_bootstrap_password
RABBITMQ_USER=minimart
RABBITMQ_PASSWORD=local_rabbitmq_password
RABBITMQ_URL=amqp://minimart:local_rabbitmq_password@rabbitmq:5672/minimart
IDENTITY_DB_PASSWORD=local_identity_password
PRODUCT_DB_PASSWORD=local_product_password
INVENTORY_DB_PASSWORD=local_inventory_password
SALES_DB_PASSWORD=local_sales_password
REPORT_DB_PASSWORD=local_report_password

# DEV-1 local/demo settings. Replace JWT_SECRET outside local demo.
JWT_SECRET=local-demo-jwt-signing-secret-change-me-at-least-32-characters
JWT_ISSUER=minimart-identity
JWT_AUDIENCE=minimart-api
JWT_ACCESS_TTL_SECONDS=300
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_TIMEOUT_MS=5000
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=MiniMartDemo!2026
APP_NODE_ENV=development
CSRF_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
