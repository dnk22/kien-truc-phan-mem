generator client {
  provider = "prisma-client-js"
  output = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Technical marker only. Domain tables arrive in their respective milestones.
model FoundationMetadata {
  key String @id
  value String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("foundation_metadata")
}

enum InvoiceStatus {
  PENDING
  READY
  PROCESSING
  RECOVERY
  COMPLETED
  FAILED
  CANCELLED
}
enum SagaIntent {
  RESERVE
  COMMIT
  RELEASE
  NONE
}
enum PaymentMethod {
  CASH
  BANK_TRANSFER
}
enum OutboxStatus {
  PENDING
  SENT
}
model Invoice {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  cashierId String @map("cashier_id") @db.Uuid
  status InvoiceStatus @default(PENDING)
  sagaIntent SagaIntent @default(RESERVE) @map("saga_intent")
  totalAmount BigInt @map("total_amount")
  reservationId String? @unique @map("reservation_id") @db.Uuid
  prepareKey String @map("prepare_key") @db.VarChar(128)
  prepareHash String @map("prepare_hash")
  confirmKey String? @map("confirm_key") @db.VarChar(128)
  confirmHash String? @map("confirm_hash")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  items InvoiceItem[]
  payment Payment?
  @@unique([cashierId,prepareKey])
  @@unique([cashierId,confirmKey])
  @@index([status,nextAttemptAt])
  @@index([cashierId,createdAt])
  @@map("invoices")
}
model InvoiceItem {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  productId String @map("product_id") @db.Uuid
  productCode String @map("product_code")
  productName String @map("product_name")
  unit String
  quantity Int
  unitPrice BigInt @map("unit_price")
  subtotal BigInt
  @@unique([invoiceId,productId])
  @@map("invoice_items")
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @unique @map("invoice_id") @db.Uuid
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  method PaymentMethod
  amountReceived BigInt @map("amount_received")
  changeAmount BigInt @map("change_amount")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("payments")
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  eventType String @map("event_type")
  payload Json
  status OutboxStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  @@index([status,nextAttemptAt])
  @@map("outbox_events")
}
