}
class ProductDirectoryClient
class PrismaStockRepository
class PrismaReservationRepository
StockController --> StockService
InternalStockController --> StockService
InternalStockController --> ReservationService
StockService --> ProductDirectory
StockService --> StockRepository
ReservationService --> ReservationRepository
ProductDirectoryClient ..|> ProductDirectory
PrismaStockRepository ..|> StockRepository
