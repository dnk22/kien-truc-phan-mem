}
interface ProductDirectory {
 +batch(...)
+list(...)
}
interface StockRepository {
 +get(...)
+byProducts(...)
+createAdjustment(...)
+confirmAdjustment(...)
}
interface ReservationRepository {
 +reserve(...)
+byInvoice(...)
