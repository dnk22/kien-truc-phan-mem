@startuml
skinparam componentStyle rectangle
actor User
component "Web / React" as web
component "API Gateway" as gw
component Identity as identity
component Product as product
component Inventory as inventory
component Sales as sales
component Report as report
queue RabbitMQ as mq
database identity_db as di
database product_db as dp
database inventory_db as dv
database sales_db as ds
database report_db as dr
User --> web
web --> gw : public REST
gw --> identity
gw --> product
gw --> inventory
gw --> sales
gw --> report
product ..> identity : live session
inventory ..> identity : live session
sales ..> identity : live session
report ..> identity : live session
inventory --> product : internal batch
sales --> product : internal batch
sales --> inventory : reserve / commit / release
report --> inventory : stock summary
sales --> mq : outbox publish
mq --> report : sale.completed.v1
identity --> di
product --> dp
inventory --> dv
sales --> ds
report --> dr
@enduml
